+#     (GITHUB_TOKEN 으로 기동 가능한 이벤트는 workflow_dispatch — GitHub 문서 기준).
+#     → Threads 가 10시대까지 대기해도 Facebook 은 06:06 시간대에 독립적으로 게시된다.
 # Facebook 전용 값은 FACE_ 접두(Threads 와 공유하지 않는 값).
 
 "on":
@@ -109,6 +116,27 @@ jobs:
             out/shorts/*/script.json
           retention-days: 3
 
+  # DN2026_0003 : Facebook 게시 파이프라인(face_publish.yml) 기동 — build 산출물(artifact) 기준
+  dispatch_face:
+    needs: build
+    if: needs.build.outputs.has_items == 'true'
+    runs-on: ubuntu-latest
+    timeout-minutes: 5
+    permissions:
+      actions: write   # workflow_dispatch 기동
+    steps:
+      - name: Dispatch face_publish.yml
+        env:
+          GH_TOKEN: ${{ github.token }}
+          # 정기 실행은 Variables DRY_RUN, 수동 실행은 inputs.mode 를 그대로 넘긴다
+          FACE_MODE: ${{ github.event_name == 'workflow_dispatch' && inputs.mode || ((vars.DRY_RUN || 'true') == 'false' && 'live' || 'dry_run') }}
+        run: |
+          gh workflow run face_publish.yml \
+            --repo "${{ github.repository }}" --ref "${{ github.ref_name }}" \
+            -f mode="$FACE_MODE" -f build_run_id="${{ github.run_id }}" \
+            -f timing=window -f target_date=""
+          echo "face_publish.yml 기동: mode=$FACE_MODE build_run_id=${{ github.run_id }}"
+
   publish:
     needs: build
     if: needs.build.outputs.has_items == 'true'
@@ -158,5 +186,7 @@ jobs:
           TELEGRAM_ALERT_CHAT_ID: ${{ secrets.TELEGRAM_ALERT_CHAT_ID }}
           GITHUB_TOKEN: ${{ github.token }}
           SHORTS_OUT_DIR: out/shorts
+          # DN2026_0003 : 이 job 은 Threads 동영상만 게시 (Facebook 은 face_publish.yml)
+          SHORTS_PUBLISH_CHANNELS: threads
           DRY_RUN: ${{ github.event_name == 'workflow_dispatch' && (inputs.mode == 'live' && 'false' || 'true') || (vars.DRY_RUN || 'true') }}
         run: python -m src.run_shorts_publish
